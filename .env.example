# Modelo do .env (make env gera os valores vazios). Não coloque valores reais aqui.

# Oracle
# Senha de SYS/SYSTEM do container.
ORACLE_PASSWORD=
ORACLE_HOST=localhost
ORACLE_PORT=1521
ORACLE_SERVICE=FREEPDB1
# Esquema do ERP simulado.
ERP_DB_USER=erp
ERP_DB_PASSWORD=
# Senha comum aos esquemas hub_* (raw, stg, dw, int, ops, audit) no ambiente local.
HUB_DB_PASSWORD=
# Esquema do utPLSQL (framework de testes de PL/SQL).
UT3_PASSWORD=

# Simulador
# Perfil de volume definido em simulator/config.yaml: test, dev ou benchmark.
SIM_PROFILE=dev
# Token dos endpoints /admin das APIs simuladas (só o simulador usa).
SIM_ADMIN_TOKEN=
CHAOS_CONFIG_PATH=simulator/chaos.yaml
CHAOS_LEDGER_DIR=data/chaos

# Loja B2B (REST)
B2B_BASE_URL=http://localhost:8001
B2B_API_TOKEN=
B2B_RATE_LIMIT_PER_MINUTE=120
B2B_RATE_LIMIT_BURST=20

# CRM (webhooks)
CRM_BASE_URL=http://localhost:8002
CRM_API_TOKEN=
CRM_RATE_LIMIT_PER_MINUTE=60
CRM_RATE_LIMIT_BURST=10
CRM_WEBHOOK_SECRET=
# Destino dos webhooks; fica vazio até o receptor existir (Fase 2). Eventos aguardam na outbox.
CRM_WEBHOOK_URL=

# Gateway de pagamento (webhooks + API de consulta)
PAYMENTS_BASE_URL=http://localhost:8003
PAYMENTS_API_TOKEN=
PAYMENTS_RATE_LIMIT_PER_MINUTE=60
PAYMENTS_RATE_LIMIT_BURST=10
PAYMENTS_WEBHOOK_SECRET=
PAYMENTS_WEBHOOK_URL=

# Fornecedor legado (SFTP)
SFTP_HOST=localhost
SFTP_PORT=2222
SFTP_USER=fornecedor
SFTP_PASSWORD=
